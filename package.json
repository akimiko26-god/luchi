{
  "name": "luchi",
  "version": "0.1.0",
  "private": true,
  "description": "ЛУЧИ — социальная платформа, где ценность измеряется подтверждёнными добрыми делами",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @luchi/shared-types",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "render:predeploy": "node scripts/render-predeploy.cjs",
    "render:seed": "npm run db:seed -w @luchi/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
