# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002

# Database
DATABASE_URL=postgresql://luchi:luchi_dev@localhost:5432/luchi?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (dev: HS256 secret; prod: RS256 keys)
JWT_SECRET=dev-change-me-use-openssl-for-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev
S3_BUCKET=luchi-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Argon2
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# Security
CSRF_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Email (optional for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@luchi.app

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
