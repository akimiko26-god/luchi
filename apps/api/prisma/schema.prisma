generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["iam", "ledger", "audit", "shared", "social", "deeds", "store", "moderation"]
}

// ========== IAM ==========

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  emailVerified    Boolean   @default(false) @map("email_verified")
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  username         String    @unique @db.VarChar(50)
  displayName      String    @map("display_name") @db.VarChar(100)
  avatarUrl        String?   @map("avatar_url")
  bio              String?
  phone            String?   @db.VarChar(20)
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  city             String?   @db.VarChar(100)
  country          String    @default("RU") @db.VarChar(2)
  locale           String    @default("ru-RU") @db.VarChar(5)
  timezone         String    @default("Europe/Moscow") @db.VarChar(50)
  status           String    @default("ACTIVE") @db.VarChar(20)
  level            Int       @default(1)
  experiencePoints Int       @default(0) @map("experience_points")
  raysRank         Int?      @map("rays_rank")
  lastActiveAt     DateTime? @map("last_active_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sessions  Session[]
  userRoles UserRole[]

  @@index([status])
  @@map("users")
  @@schema("iam")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  refreshTokenHash   String    @unique @map("refresh_token_hash") @db.VarChar(255)
  deviceFingerprint  String?   @map("device_fingerprint") @db.VarChar(255)
  ipAddress          String?   @map("ip_address")
  userAgent          String?   @map("user_agent")
  geoCountry         String?   @map("geo_country") @db.VarChar(2)
  geoCity            String?   @map("geo_city") @db.VarChar(100)
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("iam")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("iam")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("iam")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("iam")
}

// ========== LEDGER ==========

model Account {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  ownerType   String   @map("owner_type") @db.VarChar(20)
  accountType String   @default("MAIN") @map("account_type") @db.VarChar(20)
  currency    String   @default("RAYS") @db.VarChar(10)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@unique([ownerId, ownerType, accountType])
  @@index([ownerId, ownerType])
  @@map("accounts")
  @@schema("ledger")
}

model LedgerTransaction {
  id              String    @id @default(uuid()) @db.Uuid
  idempotencyKey  String    @unique @map("idempotency_key") @db.VarChar(255)
  transactionType String    @map("transaction_type") @db.VarChar(30)
  status          String    @default("POSTED") @db.VarChar(20)
  reason          String
  sourceType      String?   @map("source_type") @db.VarChar(50)
  sourceId        String?   @map("source_id") @db.Uuid
  initiatedBy     String    @map("initiated_by") @db.Uuid
  metadata        Json      @default("{}")
  postedAt        DateTime? @map("posted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@index([initiatedBy, createdAt(sort: Desc)])
  @@index([transactionType])
  @@map("transactions")
  @@schema("ledger")
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  entryType     String   @map("entry_type") @db.VarChar(10)
  amount        Int
  status        String   @default("POSTED") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account           @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt(sort: Desc)])
  @@map("ledger_entries")
  @@schema("ledger")
}

// ========== AUDIT ==========

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      String   @default("USER") @map("actor_type") @db.VarChar(20)
  action         String   @db.VarChar(100)
  resourceType   String   @map("resource_type") @db.VarChar(50)
  resourceId     String?  @map("resource_id") @db.Uuid
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  correlationId  String?  @map("correlation_id") @db.Uuid
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_log")
  @@schema("audit")
}

// ========== SHARED ==========

model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
  @@schema("shared")
}

// ========== SOCIAL ==========

model Post {
  id             String   @id @default(uuid()) @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  content        String
  visibility     String   @default("PUBLIC") @db.VarChar(20)
  status         String   @default("ACTIVE") @db.VarChar(20)
  likesCount     Int      @default(0) @map("likes_count")
  commentsCount  Int      @default(0) @map("comments_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  comments Comment[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("posts")
  @@schema("social")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String
  status     String   @default("ACTIVE") @db.VarChar(20)
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
  @@schema("social")
}

model Reaction {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  targetType   String   @map("target_type") @db.VarChar(20)
  targetId     String   @map("target_id") @db.Uuid
  reactionType String   @default("LIKE") @map("reaction_type") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
  @@schema("social")
}

// ========== DEEDS ==========

model DeedCategory {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  description   String?
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(7)
  baseRewardMin Int      @default(5) @map("base_reward_min")
  baseRewardMax Int      @default(50) @map("base_reward_max")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tasks DeedTask[]

  @@map("categories")
  @@schema("deeds")
}

model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerUserId          String    @map("owner_user_id") @db.Uuid
  name                 String    @db.VarChar(200)
  slug                 String    @unique @db.VarChar(100)
  description          String?
  city                 String?   @db.VarChar(100)
  verificationStatus   String    @default("VERIFIED") @map("verification_status") @db.VarChar(20)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  tasks DeedTask[]

  @@map("organizations")
  @@schema("deeds")
}

model DeedTask {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String?  @map("organization_id") @db.Uuid
  categoryId           String   @map("category_id") @db.Uuid
  title                String   @db.VarChar(200)
  description          String
  rewardMin            Int      @map("reward_min")
  rewardMax            Int      @map("reward_max")
  locationType         String   @default("ANY") @map("location_type") @db.VarChar(20)
  locationCity         String?  @map("location_city") @db.VarChar(100)
  maxParticipants      Int?     @map("max_participants")
  currentParticipants  Int      @default(0) @map("current_participants")
  status               String   @default("ACTIVE") @db.VarChar(20)
  createdBy            String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  category     DeedCategory     @relation(fields: [categoryId], references: [id])
  organization Organization?    @relation(fields: [organizationId], references: [id])
  submissions  DeedSubmission[]

  @@index([status, createdAt(sort: Desc)])
  @@map("tasks")
  @@schema("deeds")
}

model DeedSubmission {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  description     String?
  status          String    @default("PENDING") @db.VarChar(20)
  rewardAmount    Int?      @map("reward_amount")
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String?   @map("rejection_reason")
  transactionId   String?   @map("transaction_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  task           DeedTask                   @relation(fields: [taskId], references: [id])
  attachments    DeedAttachment[]
  confirmations  BeneficiaryConfirmation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("submissions")
  @@schema("deeds")
}

model DeedAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  kind         String   @db.VarChar(20)
  url          String
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at")

  submission DeedSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("attachments")
  @@schema("deeds")
}

model BeneficiaryConfirmation {
  id                 String    @id @default(uuid()) @db.Uuid
  submissionId       String    @map("submission_id") @db.Uuid
  beneficiaryUserId  String    @map("beneficiary_user_id") @db.Uuid
  status             String    @default("PENDING") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at")
  respondedAt        DateTime? @map("responded_at")

  submission DeedSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, beneficiaryUserId])
  @@index([beneficiaryUserId, status])
  @@map("beneficiary_confirmations")
  @@schema("deeds")
}

// ========== STORE ==========

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  description String?
  imageEmoji  String?  @map("image_emoji") @db.VarChar(8)
  imageUrl    String?  @map("image_url")
  priceRays   Int      @map("price_rays")
  stock       Int      @default(50)
  productType String   @default("PHYSICAL") @map("product_type") @db.VarChar(20)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("products")
  @@schema("store")
}

model StoreOrder {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  status        String   @default("PAID") @db.VarChar(20)
  totalRays     Int      @map("total_rays")
  transactionId String?  @map("transaction_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  items OrderItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
  @@schema("store")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  priceRays Int      @map("price_rays")
  createdAt DateTime @default(now()) @map("created_at")

  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@map("order_items")
  @@schema("store")
}
